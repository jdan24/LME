# Copy this file to .env.prod and fill in your values before running the
# backend with start-prod.bat. .env.prod is gitignored and should never be
# committed.

# Bloomberg EMSX account number
EMSX_ACCOUNT=your_account_here

# Bloomberg EMSX broker code
EMSX_BROKER=your_broker_code_here

# Bloomberg Desktop API connection (defaults work for Bloomberg Terminal on localhost)
BBG_HOST=localhost
BBG_PORT=8194

# EMSX service endpoint for live / production — orders placed here are real.
EMSX_SERVICE=//blp/emapisvc
