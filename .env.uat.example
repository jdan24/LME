# Copy this file to .env.uat and fill in your values before running the
# backend with start-uat.bat. .env.uat is gitignored and should never be
# committed.

# Bloomberg EMSX account number
EMSX_ACCOUNT=your_account_here

# Bloomberg EMSX broker code
EMSX_BROKER=your_broker_code_here

# Bloomberg Desktop API connection (defaults work for Bloomberg Terminal on localhost)
BBG_HOST=localhost
BBG_PORT=8194

# EMSX service endpoint for UAT / testing — do not change to the live endpoint here.
EMSX_SERVICE=//blp/emapisvc_beta
